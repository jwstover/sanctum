      ],
      "code?": false,
      "down": "DROP FUNCTION IF EXISTS deck_favorites_count_trigger();",
      "global?": false,
      "name": "deck_favorite_count_fn",
      "up": "CREATE OR REPLACE FUNCTION deck_favorites_count_trigger() RETURNS trigger AS $$\nBEGIN\n  IF TG_OP = 'INSERT' THEN\n    UPDATE decks SET favorite_count = favorite_count + 1 WHERE id = NEW.deck_id;\n    RETURN NEW;\n  ELSE\n    UPDATE decks SET favorite_count = GREATEST(favorite_count - 1, 0) WHERE id = OLD.deck_id;\n    RETURN OLD;\n  END IF;\nEND;\n$$ LANGUAGE plpgsql;\n"
    },
    {
      "after_tables": [
        "decks"
      ],
      "code?": false,
      "down": "DROP TRIGGER IF EXISTS deck_favorites_count ON deck_favorites;",
      "global?": false,
      "name": "deck_favorite_count_trigger",
      "up": "CREATE TRIGGER deck_favorites_count\nAFTER INSERT OR DELETE ON deck_favorites\nFOR EACH ROW EXECUTE FUNCTION deck_favorites_count_trigger();\n"
    },
    {
      "after_tables": [
        "decks"
      ],
      "code?": false,
      "down": "SELECT 1;",
      "global?": false,
      "name": "deck_favorite_count_backfill",
      "up": "UPDATE decks d SET favorite_count = f.n\nFROM (SELECT deck_id, count(*) AS n FROM deck_favorites GROUP BY deck_id) f\nWHERE d.id = f.deck_id;\n"
    }
